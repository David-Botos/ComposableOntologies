---
import { LINKS, HAS_X_COMMUNITY, HAS_DISCORD } from '../config';
const { compact = false } = Astro.props;
const buttondownAction = `https://buttondown.com/api/emails/embed-subscribe/${LINKS.buttondownUsername}`;
---

<section id="join" class="join">
  {!compact && (
    <div class="join__head">
      <h2>Help build this in the open.</h2>
      <p class="join__mission">
        <strong>Builders, ontologists, operators, domain experts, and the
        companies betting on AI that works</strong> — this thesis only becomes
        real with your judgment. This is the ground floor.
      </p>
    </div>
  )}

  <!-- Primary, low-stakes entry point: the Discord. One dominant card that
       always carries its own button on every variant. -->
  <div class="stackbox join__discord">
    <div class="join__discordText">
      {HAS_DISCORD ? (
        <>
          <h3 class="join__cardTitle join__discordTitle">
            <svg class="join__discordMark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
              <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            Join the Discord
          </h3>
          <p class="muted join__cardBody">
            Where builders, ontologists, and operators gather. Lurk, argue, or ship.
          </p>
        </>
      ) : HAS_X_COMMUNITY ? (
        <>
          <h3 class="join__cardTitle join__discordTitle">Join the group on X</h3>
          <p class="muted join__cardBody">
            Where people building this infrastructure gather. Lurk, argue, or ship.
          </p>
        </>
      ) : (
        <>
          <h3 class="join__cardTitle join__discordTitle">Introduce yourself</h3>
          <p class="muted join__cardBody">
            Follow the work, then reach out — tell me what you'd build, what
            you'd challenge, and where your expertise fits. A community forms
            once there are enough of us.
          </p>
        </>
      )}
    </div>
    <div class="join__discordCta">
      <a
        class="btn btn--primary join__discordBtn"
        href={HAS_DISCORD ? LINKS.discord : HAS_X_COMMUNITY ? LINKS.xCommunity : LINKS.xProfile}
        target="_blank"
        rel="noopener"
      >
        {HAS_DISCORD
          ? 'Join the Discord →'
          : HAS_X_COMMUNITY
            ? 'Join the X community →'
            : 'Follow the build →'}
      </a>
      {HAS_DISCORD && (
        <p class="join__reassure muted">Free · no pitch · be one of the first in.</p>
      )}
    </div>
  </div>

  <!-- Secondary paths, deliberately quiet: prefer-email disclosure + LinkedIn. -->
  <div class="join__secondary">
    <details class="join__news">
      <summary class="join__newsSummary">
        Prefer email? Get the monthly digest
        <span class="join__newsHint muted">— graph data, ontologies, entity resolution</span>
      </summary>
      <div class="join__newsBody">
        <form
          class="sub"
          action={buttondownAction}
          method="post"
          target="_blank"
        >
          <label class="sr-only" for="bd-email">Email address</label>
          <input
            id="bd-email"
            type="email"
            name="email"
            placeholder="you@domain.com"
            autocomplete="email"
            required
          />
          <button type="submit" class="btn">Subscribe →</button>
        </form>
        <p class="sub__status" role="status" aria-live="polite" hidden>
          Thanks — check your inbox to confirm your subscription.
        </p>
        <p class="sub__fine muted">No spam. One email a month. Unsubscribe anytime.</p>
      </div>
    </details>
    <a class="join__alt" href={LINKS.linkedin} target="_blank" rel="noopener">
      Or connect on LinkedIn →
    </a>
  </div>
</section>

<style>
  .join__mission {
    margin: 1rem 0 0;
    max-width: 60ch;
    color: var(--cream-dim);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.55;
  }
  .join__mission strong {
    color: var(--cream);
  }
  .join__head {
    max-width: 62ch;
    margin-bottom: 2.2rem;
  }
  .join__cardTitle {
    margin: 0.2rem 0 0;
  }
  .join__cardBody {
    margin: 0;
    font-size: 0.95rem;
  }

  /* Primary: the dominant Discord card. Accent border + mint wash so the eye
     lands here first; text left, CTA right, stacking on narrow screens. */
  .join__discord {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.2rem, 4vw, 2.5rem);
    padding: clamp(1.4rem, 3.5vw, 2.2rem);
    border-color: var(--mint);
    background:
      linear-gradient(
        color-mix(in srgb, var(--mint) 8%, transparent),
        color-mix(in srgb, var(--mint) 8%, transparent)
      ),
      var(--bg-panel, transparent);
  }
  .join__discordText {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-width: 52ch;
  }
  .join__discordTitle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
  }
  .join__discordMark {
    color: var(--mint);
    flex-shrink: 0;
  }
  .join__discordCta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .join__discordBtn {
    font-size: 1rem;
    padding: 1em 1.6em;
    white-space: nowrap;
  }
  .join__reassure {
    margin: 0;
    font-size: 0.78rem;
  }

  /* Secondary: quiet email disclosure + LinkedIn, well below the primary. */
  .join__secondary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
    margin-top: 1.6rem;
  }
  .join__news {
    min-width: 0;
  }
  .join__newsSummary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--cream-dim);
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }
  .join__newsSummary::-webkit-details-marker {
    display: none;
  }
  .join__newsSummary::before {
    content: '+ ';
    color: var(--mint);
  }
  .join__news[open] .join__newsSummary::before {
    content: '– ';
  }
  .join__newsSummary:hover {
    color: var(--cream);
  }
  .join__newsHint {
    font-size: 0.8rem;
  }
  .join__newsBody {
    margin-top: 0.9rem;
    max-width: 34rem;
  }
  .join__alt {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .join__alt:hover {
    color: var(--mint);
    text-decoration: none;
  }
  .sub {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    flex-wrap: wrap;
  }
  .sub input {
    flex: 1;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--cream);
    background: var(--bg);
    border: 1px solid var(--line-bright);
    border-radius: var(--radius);
    padding: 0.7em 0.9em;
  }
  .sub input::placeholder {
    color: var(--muted-2);
  }
  .sub input:focus-visible {
    border-color: var(--mint);
    outline: none;
  }
  .sub__status {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    color: var(--mint);
  }
  .sub__fine {
    font-size: 0.75rem;
    margin: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* tablets/phones: stack the Discord card so the CTA sits under the pitch */
  @media (max-width: 640px) {
    .join__discord {
      flex-direction: column;
      align-items: flex-start;
    }
    .join__discordCta {
      align-items: stretch;
      width: 100%;
    }
    .join__discordBtn {
      display: flex;
      justify-content: center;
    }
  }

  /* phones: stack controls full-width for easy tapping */
  @media (max-width: 520px) {
    .join__secondary {
      flex-direction: column;
      align-items: stretch;
    }
    .join__alt {
      white-space: normal;
    }
    .sub {
      flex-direction: column;
    }
    .sub input,
    .sub button {
      width: 100%;
    }
  }
</style>

<script>
  // The newsletter form posts to Buttondown in a new tab; reveal an on-page
  // confirmation so the funnel endpoint gives visible feedback instead of a
  // silent submit.
  document.querySelectorAll('.sub').forEach((form) => {
    form.addEventListener('submit', () => {
      const status = form.parentElement?.querySelector('.sub__status');
      if (status) status.hidden = false;
    });
  });
</script>
