---
/**
 * Lightweight animated node-graph, drawn on <canvas>.
 * Echoes the Galadriel deck's network visual. No dependencies.
 * Honors prefers-reduced-motion (renders a still frame instead of animating).
 */
interface Props {
  height?: string;
  density?: number; // nodes; scaled down on small screens
}
const { height = '100%', density = 46 } = Astro.props;
---

<div class="graph" style={`--gh:${height}`}>
  <canvas data-graph data-density={density} aria-hidden="true"></canvas>
  <div class="graph__fade"></div>
</div>

<style>
  .graph {
    position: relative;
    width: 100%;
    height: var(--gh);
    min-height: 260px;
  }
  .graph canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* soft vignette so nodes fade at the edges like the deck */
  .graph__fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      transparent 55%,
      var(--bg) 100%
    );
  }
</style>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; r: number; sq: boolean };

  function initGraph(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const density = Number(canvas.dataset.density || 46);

    let nodes: Node[] = [];
    let w = 0;
    let h = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let raf = 0;

    const COLORS = {
      line: 'rgba(233, 226, 205, 0.10)',
      lineHot: 'rgba(143, 230, 164, 0.28)',
      node: 'rgba(242, 236, 218, 0.85)',
      nodeMint: 'rgba(143, 230, 164, 0.95)',
    };

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(w * dpr));
      canvas.height = Math.max(1, Math.floor(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(14, Math.round(density * Math.min(1, w / 900)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.22,
        vy: (Math.random() - 0.5) * 0.22,
        r: Math.random() < 0.18 ? 2.6 : 1.5 + Math.random() * 1.4,
        sq: Math.random() < 0.22,
      }));
    }

    const LINK_DIST = 140;

    function frame() {
      ctx.clearRect(0, 0, w, h);

      // edges
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < LINK_DIST) {
            const t = 1 - d / LINK_DIST;
            ctx.strokeStyle =
              i % 9 === 0 ? COLORS.lineHot : COLORS.line;
            ctx.globalAlpha = t;
            ctx.lineWidth = 0.7;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 1;

      // nodes
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        ctx.fillStyle = i % 7 === 0 ? COLORS.nodeMint : COLORS.node;
        if (n.sq) {
          ctx.fillRect(n.x - n.r, n.y - n.r, n.r * 2, n.r * 2);
        } else {
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
          ctx.fill();
        }

        if (!reduce) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > w) n.vx *= -1;
          if (n.y < 0 || n.y > h) n.vy *= -1;
        }
      }

      if (!reduce) raf = requestAnimationFrame(frame);
    }

    resize();
    frame();

    let rt: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(rt);
      rt = window.setTimeout(() => {
        cancelAnimationFrame(raf);
        resize();
        frame();
      }, 150);
    });

    // pause when offscreen
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (reduce) return;
        if (e.isIntersecting) {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(frame);
        } else {
          cancelAnimationFrame(raf);
        }
      }
    });
    io.observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-graph]').forEach(initGraph);
</script>
