---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBlock from '../components/JoinBlock.astro';

const gaps = [
  'No way to author an ontology without legacy OWL / semantic-web tooling.',
  'No way to share one, or build it collaboratively.',
  'No tooling to knit two ontologies together.',
  'Ontologies aren’t code, so agents can’t help build them.',
  'No way to run an ontology-as-code to constrain LLM extraction into valid graph additions.',
  'No tooling for agents to prune context — to drop what no longer earns its place.',
];

const building = [
  {
    k: 'Author & share ontologies, as code',
    d: 'Build ontologies together and express them as code — one definition that drives AI extraction and entity resolution.',
  },
  {
    k: 'Compose ontologies into layered insight',
    d: 'The glue that turns two domain models into insight neither holds alone.',
  },
  {
    k: 'Navigate the substrate with agents',
    d: 'Explore composed ontologies with agents, so anyone can build their own brain on the shared substrate.',
  },
];

// The staged flow an org moves through to define and compose ontologies.
// `status` is deliberately honest: grounded = backed by the research so far,
// progress = partly explored, open = an unresolved question we're inviting
// people to work on. This is a map still forming, not an arrived-at design.
const stages = [
  {
    k: 'Model your domain',
    d: 'Define the schema and constraints for one domain’s data — its shapes, its keys, what “valid” means inside that world.',
    status: 'grounded',
    note: 'What the research so far actually investigated.',
    link: {
      href: '/blog/choosing-a-language-for-composable-ontologies/',
      label: 'Deep dive on stage 1: what language to define it in →',
    },
  },
  {
    k: 'Extract structured data into that model',
    d: 'Turn raw sources — tickets, emails, commits — into instances of the schema, proposed and reviewed before they land.',
    status: 'open',
    note: 'Not yet researched in depth.',
  },
  {
    k: 'Resolve within a domain',
    d: 'Merge duplicate and overlapping records inside one ontology — the same entity, seen twice, collapsed into one node.',
    status: 'grounded',
    note: 'Pluggable deterministic-then-probabilistic entity resolution is a known pattern in the record-linkage field.',
  },
  {
    k: 'Link across domains',
    d: 'Typed relations between distinct ontologies that stay distinct — a support model referencing a contracts model without either dissolving into the other.',
    status: 'open',
    note: 'The least resolved stage — and closest to the problem OntoIOp / DOL spent over a decade on without reaching adoption-grade tooling.',
    invite:
      'If you’ve built cross-ontology linking — or watched it fail — this is the stage I most want challenged. Where does a typed link between two independently-owned models break first?',
  },
  {
    k: 'Operate and grow the graph',
    d: 'Humans and agents acting on the graph over time — proposing, reviewing, approving, pruning what no longer earns its place.',
    status: 'progress',
    note: 'Partially explored, mostly open.',
  },
];

const statusLabels = {
  grounded: 'grounded',
  progress: 'in progress',
  open: 'open question',
};

// The four constituencies. One source of truth so "who it's for" (what each
// group gets) and "why it can't be built alone" (why each group's contribution
// is the missing piece) stay in lockstep — same order, number, and accent.
const parties = [
  {
    n: '01',
    accent: 'var(--blue)',
    role: 'Companies & teams',
    stake:
      'Run on your own data as a durable asset — not a black box you rent and can’t inspect.',
    why: 'You hit the messy, real use cases no roadmap predicts. Your constraints are what keep this honest instead of academic.',
  },
  {
    n: '02',
    accent: 'var(--amber)',
    role: 'Operators & domain experts',
    stake:
      'Model your own world — the caseworker, clinician, or ops lead who actually knows it, not a data team guessing at it.',
    why: 'Your domain only models correctly if the person who lives it draws the map. No one can guess it for you.',
  },
  {
    n: '03',
    accent: 'var(--mint)',
    role: 'Ontologists & researchers',
    stake:
      'Carry the rigor of the field the last mile — into tooling people outside the lab actually ship.',
    why: 'Decades of rigor shouldn’t stay in papers. Your judgment is how we avoid reinventing what the field already knows.',
  },
  {
    n: '04',
    accent: 'var(--coral)',
    role: 'Builders & engineers',
    stake:
      'Author, compose, and run ontologies as code — with agents that can finally help build them.',
    why: 'The tooling only gets real if the people who’ll live in it shape its ergonomics now, not after it’s set.',
  },
];

// The buzzword cloud — breadth. Every term people are being sold in AI right
// now; the point of the section is that each only works grounded in your own
// model of your own world.
const buzzwords = [
  'RAG', 'GraphRAG', 'AI agents', 'knowledge graphs', 'entity resolution',
  'customer 360', 'semantic search', 'decision intelligence', 'explainable AI',
  'data provenance', 'digital twins', 'AI memory', 'personalization',
  'interoperability',
];

// The capabilities — depth. Each pairs the outcome with how composable
// ontologies make it real on the org's own terms.
const capabilities = [
  {
    k: 'Grounded answers, not hallucinations',
    d: 'LLMs respond from your resolved graph — every claim traceable to a real source in your data, not a confident guess.',
  },
  {
    k: 'Agents that know your business',
    d: 'They act with your domain’s real context and rules in hand, not a generic prompt that flattens what makes you you.',
  },
  {
    k: 'One resolved view of everything',
    d: 'The same customer, patient, or asset matched across every system — on the matching rules you set, not a vendor’s defaults.',
  },
  {
    k: 'Decisions with the whole chain',
    d: 'Who wanted what, what it traded against, what it touched — reasoning across domains, not another dashboard.',
  },
  {
    k: 'Provenance and compliance by construction',
    d: 'Every node source-cited and human-gated. When someone asks you to show your work, the graph already has.',
  },
  {
    k: 'Interoperable without a rewrite',
    d: 'Compose domains that stay distinct instead of collapsing them into one schema — your models keep their nuance and still connect.',
  },
];

---

<BaseLayout
  title="The Concept"
  path="/concept"
  description="Composable ontologies would unlock real value — but the tools for domain experts to build, share, compose, and execute their own ontologies don't exist yet. That gap is the project."
>
  <!-- ========================================================= WHO / WHY -->
  <section class="who wrap">
    <p class="who__kicker term"><span class="k">//</span> the project</p>
    <h1 class="who__statement">
      Open infrastructure for <em>composable ontologies</em> — owned by the
      field, not sold as a product.
    </h1>

    <p class="who__define">
      First, plainly: an <strong>ontology</strong> is a map of what matters in one
      domain and how its pieces connect — a chef's map of a kitchen isn't a
      surgeon's map of an OR. <strong>Composable</strong> means each domain keeps
      its own map and defines how they join, instead of everyone being forced
      onto one.
    </p>

    <div class="who__manifesto bracket">
      <div class="bracket-corners"></div>
      <p>
        I'm against vendor capture for a reason bigger than architecture. When
        the substrate everyone builds on is owned by one company, the future
        arrives on that company's terms — its roadmap, its price, its permission.
      </p>
      <p>
        I want the other future: AI that genuinely enhances what people can do,
        and hands that leverage to individuals — inside companies and outside
        them — so they can point these tools at the goals that actually matter to
        them, and build work and lives with more meaning in them.
        <strong>Open infrastructure is how that future stays open to everyone —
        not just whoever owns the platform.</strong>
      </p>
    </div>

    <p class="who__cta">
      <a href="#join" class="btn">Jump to how to help ↓</a>
    </p>

    <h2 class="who__label mono-label"><span class="who__labelK">//</span> who it's for</h2>
    <ul class="who__parties">
      {
        parties.map((p) => (
          <li class="who__party" style={`--accent: ${p.accent};`}>
            <span class="who__idx" aria-hidden="true">{p.n}</span>
            <div class="who__body">
              <h3 class="who__role">{p.role}</h3>
              <p class="who__stake">{p.stake}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="rule" />

  <!-- ========================================================= WHY / TOGETHER -->
  <section class="section wrap why">
    <p class="why__kicker term"><span class="k">//</span> why it can't be built alone</p>
    <h2 class="why__title">
      The same reason it's composable is the reason I can't build it alone.
    </h2>
    <p class="lead why__intro">
      No single person has the expertise to model every domain — support,
      clinical, legal, civic, and ops each demand someone who actually lives in
      them. That's not a hiring gap; it's the whole premise. Composable
      ontologies exist <em>because</em> no one perspective captures every domain.
      So the project has to be built the way the architecture works: many
      experts, each owning the corner they know, composed. Building it alone
      would contradict its own thesis.
    </p>

    <ol class="why__list">
      {
        parties.map((p) => (
          <li class="why__item" style={`--accent: ${p.accent};`}>
            <span class="why__n" aria-hidden="true">{p.n}</span>
            <div class="why__body">
              <h3 class="why__role">{p.role}</h3>
              <p class="why__text">{p.why}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <hr class="rule" />

  <!-- ======================================================= WHAT'S POSSIBLE -->
  <section class="section wrap poss">
    <p class="poss__kicker term"><span class="k">//</span> what it makes possible</p>
    <h2 class="poss__title">
      Every buzzword you've been sold — grounded in your own data.
    </h2>
    <p class="lead poss__intro">
      RAG, agents, a customer 360, decision intelligence, explainable AI — all of
      it is being pitched to you right now. Here's the part the pitch skips: each
      one only works when it's grounded in <strong>your organization's actual
      model of its own world</strong>, not a vendor's generic one. Compose that
      model yourself — on your terms, with your rules — and these stop being
      slideware.
    </p>

    <ul class="poss__cloud">
      {buzzwords.map((b) => <li class="tag poss__chip">{b}</li>)}
    </ul>

    <ul class="poss__grid">
      {
        capabilities.map((c) => (
          <li class="poss__cell">
            <h3 class="poss__k">{c.k}</h3>
            <p class="poss__d">{c.d}</p>
          </li>
        ))
      }
    </ul>

    <div class="proof">
      <p class="proof__tag term"><span class="k">//</span> not hypothetical</p>
      <p class="proof__body">
        For one client I generated a bespoke interface from their code, meetings,
        emails, and tickets — the graph surfacing the right context at the right
        time. Nobody designed that page. It was assembled from the substrate, for
        that client, once.
      </p>
    </div>

    <p class="poss__personal">
      <span class="term"><span class="k">//</span> and not only at work&nbsp;&nbsp;</span>
      The same substrate is how personal AI finally works for a <em>person</em>:
      your own domains — health, finances, projects, the people you know — modeled
      your way and composed into a brain you own, not one you rent.
    </p>
  </section>

  <hr class="rule" />

  <!-- ============================================================== HERO -->
  <section class="chero wrap">
    <h2 class="chero__title">
      The problem is worth solving.<br />
      <span class="chero__accent">The tools to solve it don't exist yet.</span>
    </h2>
    <p class="chero__lead">
      A well-built domain graph unlocks reasoning, code, and support no flat
      pile of documents can. But no tools let a domain expert build one. Closing
      that gap is the project.
    </p>
  </section>

  <hr class="rule" />


  <!-- ========================================================== EXPERTISE -->
  <section class="section wrap band">
    <div class="band__inner">
      <h2 class="sec__h">This takes expertise, not a prompt.</h2>
      <p class="lead">
        The value isn't in pointing an LLM at your data. It's in the judgment
        underneath — designing the model, manicuring what gets in, weighing
        what carries strategic weight, pruning what doesn't.
      </p>
      <p class="muted">
        That's domain-expert work — the business-process owner, the clinician,
        the caseworker — not a data team guessing at a field they've never used.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============================================================== GAP -->
  <section class="section wrap">
    <h2 class="sec__h">The tools don't exist yet.</h2>
    <p class="lead gap__intro">
      Today you're handed legacy semantic-web tooling — OWL files, editors built
      for researchers, nothing that speaks code or agents. What's missing:
    </p>
    <ol class="gaps">
      {
        gaps.map((g, i) => (
          <li class="gap">
            <span class="gap__box" aria-hidden="true">[ ]</span>
            <span class="gap__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="gap__t">{g}</span>
          </li>
        ))
      }
    </ol>
    <p class="gap__foot">
      Every unchecked box is a tool this project intends to build — in the open,
      as infrastructure the community owns, not a personal company.
    </p>
  </section>

  <hr class="rule" />

  <!-- ========================================================== BUILDING -->
  <section class="section wrap">
    <h2 class="sec__h">So here's what we're building.</h2>
    <p class="lead build__intro">
      Three initiatives, in order — each one making the next possible.
    </p>
    <ol class="build">
      {
        building.map((p, i) => (
          <li class="pillar">
            <span class="pillar__n" aria-hidden="true">{i + 1}</span>
            <div class="pillar__body">
              <h3 class="pillar__k">{p.k}</h3>
              <p class="pillar__d">{p.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <hr class="rule" />

  <!-- ============================================================= STAGES -->
  <section class="section wrap">
    <h2 class="sec__h">The path an organization takes — and where it’s still open.</h2>
    <p class="lead stages__intro">
      Here’s the flow from one domain’s model to a composed, living graph. It’s
      not a finished architecture — some stages the research grounds, others are
      open questions. The markers say which is which. Where a stage is open,
      that’s an invitation, not a gap I’m hiding.
    </p>

    <div class="legend" aria-hidden="true">
      <span class="legend__item"><span class="dot dot--grounded"></span>grounded</span>
      <span class="legend__item"><span class="dot dot--progress"></span>in progress</span>
      <span class="legend__item"><span class="dot dot--open"></span>open question</span>
    </div>

    <ol class="stages">
      {
        stages.map((s, i) => (
          <li class={`stage stage--${s.status}`}>
            <span class="stage__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="stage__body">
              <div class="stage__head">
                <h3 class="stage__k">{s.k}</h3>
                <span class={`stage__status stage__status--${s.status}`}>
                  <span class="dot" aria-hidden="true" />
                  {statusLabels[s.status]}
                </span>
              </div>
              <p class="stage__d">{s.d}</p>
              <p class="stage__note">{s.note}</p>
              {s.invite && (
                <p class="stage__invite">
                  <span class="term"><span class="k">//</span> your move</span>
                  {' '}{s.invite}
                </p>
              )}
              {s.link && (
                <p class="stage__link">
                  <a href={s.link.href}>{s.link.label}</a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <p class="stages__foot">
      This map is still forming. If a stage is mis-ordered, mis-labeled, or
      missing — or you think two of them are really one — that’s exactly the kind
      of pushback this is here to collect.
    </p>
  </section>

  <hr class="rule" />

  <!-- ===================================================== DETERMINISTIC -->
  <section class="section wrap">
    <h2 class="sec__h">The leverage: constrain deterministic vs. LLM output.</h2>
    <p class="lead det__intro">
      A “company brain” sounds soft. But a graph with the right deterministic
      rules can model far higher-stakes domains — clinical, legal, civic — with
      precision. The craft is knowing which is which.
    </p>
    <div class="det">
      <div class="det__col">
        <h3 class="det__k">Deterministic rules</h3>
        <p class="det__what">Hard keys, constraints, validations, unit conversions.</p>
        <p class="det__when muted">
          For anything that must be right: identity, eligibility, thresholds —
          anything a wrong LLM guess would make dangerous.
        </p>
      </div>
      <div class="det__col det__col--b">
        <h3 class="det__k det__k--amber">LLM inference</h3>
        <p class="det__what">Extraction, fuzzy resolution, judgment calls, summarization.</p>
        <p class="det__when muted">
          For turning unstructured source into structured candidates — always
          proposed, never committed without a gate.
        </p>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- =========================================================== CREDENTIAL -->
  <section class="section wrap">
    <h2 class="sec__h">This isn't theory.</h2>
    <div class="cred">
      <div class="cred__stat">
        <span class="cred__num">16,879</span>
        <span class="cred__label">nodes, production data</span>
      </div>
      <div class="cred__text">
        <p>
          I built <strong>Galadriel</strong> — a knowledge graph of a whole
          company's memory — and used it to generate per-client interfaces from
          their code, meetings, emails, and tickets. It proved the real point:
          <strong>the interface is disposable; the interoperable, interpretable
          substrate underneath is the asset.</strong>
        </p>
        <p class="muted">
          It also ran me into every gap on this page. The endeavor is worth it —
          just bottlenecked by tools that don't exist. So the plan is to build
          them.
        </p>
        <p class="cred__link"><a href="/blog/every-company-needs-its-own-ontology/">Read the longer write-up →</a></p>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section--tight wrap">
    <JoinBlock />
  </section>
</BaseLayout>

<style>
  /* --------------------------------------------------------- who / why */
  .who {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .who__kicker {
    font-size: 0.8rem;
    color: var(--mint);
    margin: 0 0 1rem;
  }
  .who__statement {
    font-size: clamp(2rem, 5vw, 3.4rem);
    max-width: 24ch;
    margin: 0 0 1.8rem;
  }
  .who__statement em {
    font-style: normal;
    color: var(--mint);
  }
  /* plain-language grounding before the term is leaned on */
  .who__define {
    max-width: 62ch;
    margin: 0 0 1.8rem;
    color: var(--cream-dim);
  }
  .who__define strong {
    color: var(--mint);
  }
  /* early exit for the reader already convinced at the top */
  .who__cta {
    margin: 0 0 2.6rem;
  }
  /* the belief / why — framed with the blueprint corner-brackets (the site's
     own motif) rather than a side border, so it reads as a deliberate,
     set-apart statement */
  .who__manifesto {
    max-width: 68ch;
    margin: 0 0 2.8rem;
  }
  .who__manifesto p {
    color: var(--cream-dim);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .who__manifesto p:last-child {
    margin-bottom: 0;
  }
  .who__manifesto strong {
    color: var(--cream);
  }
  .who__label {
    margin: 0 0 1.2rem;
    color: var(--muted);
  }
  .who__labelK {
    color: var(--mint);
  }
  .who__parties {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(0.8rem, 2vw, 1.1rem);
  }
  /* each constituency gets its own accent (--accent set inline), carried by
     the index number rather than a colored side border */
  .who__party {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: clamp(1.1rem, 2.5vw, 1.4rem);
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .who__idx {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .who__role {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: var(--cream);
  }
  .who__stake {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cream-dim);
    max-width: 42ch;
  }

  /* ------------------------------------------------------- why / together */
  /* numbered rows echo the who-it's-for accents (same number + colour per
     group) but as a list, not a second card grid — variety over repetition,
     and the accent stays on the numeral, never a side border */
  .why__kicker {
    font-size: 0.8rem;
    color: var(--mint);
    margin: 0 0 1rem;
  }
  .why__title {
    max-width: 26ch;
  }
  .why__intro {
    max-width: 66ch;
    margin-top: 1.2rem;
    color: var(--cream-dim);
  }
  .why__intro em {
    font-style: normal;
    color: var(--mint);
  }
  .why__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 80ch;
  }
  .why__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 1.6rem);
    align-items: baseline;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }
  .why__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .why__n {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(1.3rem, 3.5vw, 1.9rem);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .why__role {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    color: var(--cream);
  }
  .why__text {
    margin: 0;
    color: var(--cream-dim);
    max-width: 60ch;
  }

  /* ------------------------------------------------------ what's possible */
  .poss__kicker {
    font-size: 0.8rem;
    color: var(--mint);
    margin: 0 0 1rem;
  }
  .poss__title {
    max-width: 24ch;
  }
  .poss__intro {
    max-width: 64ch;
    margin-top: 1.2rem;
    color: var(--cream-dim);
  }
  /* buzzword cloud — breadth: hit the terms people are searching for */
  .poss__cloud {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .poss__chip {
    color: var(--cream-dim);
    /* keep the real casing — GraphRAG, RAG, AI agents — not .tag's uppercase */
    text-transform: none;
    letter-spacing: 0.02em;
  }
  /* capability grid — depth: 1px-gap dividers frame it as one panel, distinct
     from the who cards and the why list */
  .poss__grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 1px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    background: var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .poss__cell {
    background: var(--bg-panel);
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
  }
  .poss__k {
    margin: 0 0 0.5rem;
    font-size: 1.02rem;
    color: var(--cream);
    line-height: 1.3;
  }
  .poss__k::before {
    content: '→ ';
    color: var(--mint);
  }
  .poss__d {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cream-dim);
    max-width: 46ch;
  }
  .poss__personal {
    margin: 2rem 0 0;
