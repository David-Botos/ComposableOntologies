---
import BaseLayout from '../layouts/BaseLayout.astro';
import GraphCanvas from '../components/GraphCanvas.astro';
import JoinBlock from '../components/JoinBlock.astro';
import { LINKS, HAS_DISCORD } from '../config';

const unlocks = [
  {
    k: 'Interoperability',
    d: 'Data moves across domains by composing models, not collapsing them into one schema.',
  },
  {
    k: 'Interpretability',
    d: 'A typed, resolved graph gives LLMs grounded context — real answers, not guesses.',
  },
  {
    k: 'The company brain',
    d: 'Cross-domain data exchange and insights are a side effect of intelligent design.',
  },
];

// OntoIOp's four concerns — the mission, named by the Ontolog community
// (Michael Gruninger, 2011) long before this project. We restate them in plain
// language; the point of the section is that our job is to make them practical,
// not to claim the mission as new. See https://ontolog.cim3.net/wiki/OntoIOp.html
const concerns = [
  {
    k: 'Heterogeneity',
    d: 'Domains that don’t share one logic or one schema — and shouldn’t be forced to.',
  },
  {
    k: 'Modularity',
    d: 'Reuse existing models instead of rebuilding the world for every new domain.',
  },
  {
    k: 'Links',
    d: 'Relate models that stay distinct — typed connections, not a forced merge.',
  },
  {
    k: 'Annotation',
    d: 'Describe the pieces and how they connect, legibly, for people and machines.',
  },
];
---

<BaseLayout path="/">
  <!-- ============================================================ HERO -->
  <section class="hero">
    <div class="hero__bg"><GraphCanvas height="100%" density={54} /></div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <h1 class="hero__title">
        Every domain is a<br /><span class="hero__accent">unique fingerprint.</span>
      </h1>
      <p class="hero__tension">
        Support, engineering, contracts, strategy — each sees the world
        differently. Making that data <span class="hl">interoperable</span>
        across domains and <span class="hl">interpretable</span> by people and
        machines is the problem.
      </p>
      <p class="hero__lead">
        Composable ontologies are the data-structure infrastructure that makes
        it possible.
      </p>
      <div class="hero__cta">
        {HAS_DISCORD ? (
          <a href={LINKS.discord} target="_blank" rel="noopener" class="btn btn--primary">Join the Discord →</a>
        ) : (
          <a href="#join" class="btn btn--primary">Join the community →</a>
        )}
        <a href="/concept" class="btn">Read the concept</a>
      </div>
    </div>
    <div class="hero__ticker term wrap" aria-hidden="true">
      <span class="k">&gt;</span> model your domain · compose across domains ·
      exchange + grounded AI on top
    </div>
  </section>

  <hr class="rule" />

  <!-- ======================================================== UNLOCKS -->
  <section class="section--tight wrap">
    <ul class="unlocks">
      {
        unlocks.map((u) => (
          <li class="unlock">
            <span class="unlock__arrow" aria-hidden="true">→</span>
            <h2 class="unlock__k">{u.k}</h2>
            <p class="unlock__d">{u.d}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="rule" />

  <!-- ===================================================== DISPOSABLE UI -->
  <section class="section wrap disp">
    <div class="disp__text">
      <h2 class="disp__h">Interfaces become disposable.</h2>
      <p class="lead disp__lead">
        When data is interoperable and interpretable, the interface stops being
        the hard part — AI spins up a bespoke view from the right context across
        every tool.
      </p>
      <p class="disp__kicker">The UI is disposable. The data is the asset.</p>
    </div>

    <div class="disp__fig" aria-hidden="true">
      <div class="disp__screens">
        <div class="disp__screen"><span>Intake form</span></div>
        <div class="disp__screen"><span>Client portal</span></div>
        <div class="disp__screen"><span>Ops dashboard</span></div>
      </div>
      <div class="disp__gen">generated on demand · per person · per task</div>
      <div class="disp__substrate">
        <span class="disp__subname">interoperable · interpretable data</span>
        <span class="disp__subtag">the durable substrate</span>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ========================================================= PROBLEM -->
  <section class="section wrap">
    <div class="prob__grid">
      <div class="prob__text">
        <h2>One schema for everything collapses.</h2>
        <p class="lead">
          Pour every team's data into one model and the signal drowns — in a
          real 16,879-node graph,
          <strong class="coral">88% of the review queue became noise</strong>. A
          support ticket and an architecture decision don't belong in the same
          shape.
        </p>
        <p class="muted prob__cause">
          The deeper failure is <strong>authorship</strong>. No one person knows
          every domain — and no tooling lets each specialist define their own.
          Too much for one generalist.
        </p>
      </div>

      <div class="silos" aria-label="Four data silos feeding one broken strategy layer">
        <div class="silos__row">
          {[
            ['Engineering', 'GitHub'],
            ['Support', 'Tickets'],
            ['Contracts', 'Drive'],
            ['Strategy', 'Calls'],
          ].map(([domain, src]) => (
            <div class="silo">
              <div class="silo__label">{domain}</div>
              <div class="silo__db">{src}</div>
              <div class="silo__wire" />
            </div>
          ))}
        </div>
        <div class="silos__floor">Strategic direction &amp; unbuilt capability</div>
        <div class="silos__note">Context fragments. Nothing maps cleanly to strategy.</div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ============================================================ IDEA -->
  <section class="section wrap idea">
    <h2 class="idea__def">
      An <span class="hl">ontology</span> is just a map of what matters in a
      domain, and how the pieces connect.
    </h2>
    <p class="lead muted idea__sub">
      A chef's map of a kitchen isn't a surgeon's map of an OR — both exact,
      both right, different worlds. Composable ontologies let each domain keep
      its own, and define how it connects.
    </p>
  </section>

  <hr class="rule" />

  <!-- =========================================================== MISSION -->
  <section class="section wrap mission">
    <p class="mission__tag term"><span class="k">//</span> the mission has a name</p>
    <h2 class="mission__title">
      This problem was named a decade ago — in research, not in production.
    </h2>
    <p class="lead mission__lead">
      The Ontolog community named it <strong>OntoIOp</strong> — Ontology
      Integration and Interoperability — and defined these four concerns
      rigorously. What it never became: something a working developer could pick
      up and run. <strong>That gap is the opening.</strong>
    </p>

    <ul class="concerns">
      {
        concerns.map((c) => (
          <li class="concern">
            <h3 class="concern__k">{c.k}</h3>
            <p class="concern__d">{c.d}</p>
          </li>
        ))
      }
    </ul>

    <p class="mission__foot">
      Our job: carry these four out of research and into production.
      <a href="https://ontolog.cim3.net/wiki/OntoIOp.html" target="_blank" rel="noopener noreferrer">
        See OntoIOp's original framing →</a>
    </p>
  </section>

  <hr class="rule" />

  <!-- ============================================================ VISION -->
  <section class="section wrap vision">
    <h2 class="vision__title">
      Infrastructure this fundamental shouldn't belong to one vendor.
    </h2>
    <p class="lead vision__lead">
      It should be <strong>open infrastructure the whole field owns</strong> —
      the companies, operators, experts, and builders who run on it and extend
      it — <strong>not one vendor's product to rent</strong>.
      <a href="/concept">See how it works →</a>
    </p>
  </section>

  <!-- ============================================================== JOIN -->
  <section class="section--tight wrap">
    <JoinBlock />
  </section>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4rem, 12vw, 8rem) 0 clamp(2rem, 5vw, 3.5rem);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.7;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  /* dark scrim: keeps left-aligned hero text on solid bg for contrast,
     while the graph stays visible on the right */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      var(--bg) 0%,
      var(--bg) 34%,
      color-mix(in srgb, var(--bg) 70%, transparent) 58%,
      transparent 82%
    );
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
  }
  .hero__title {
    font-size: clamp(2.6rem, 8.5vw, 5.4rem);
    margin-bottom: 1.5rem;
  }
  .hero__accent {
    color: var(--mint);
  }
  .hero__tension {
    max-width: 46ch;
    margin: 0 0 1.3rem;
    font-size: clamp(1.25rem, 3vw, 1.85rem);
    line-height: 1.35;
    font-weight: 500;
    color: var(--cream);
  }
  .hl {
    color: var(--mint);
    font-weight: 700;
  }
  .hero__lead {
    max-width: 50ch;
    color: var(--cream-dim);
    font-size: 1.05rem;
    margin: 0 0 2rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* phones: full-width CTAs, stronger scrim, fainter graph for legibility */
  @media (max-width: 560px) {
    .hero {
      padding-top: clamp(2.5rem, 9vw, 4rem);
    }
    .hero__bg {
      opacity: 0.45;
    }
    .hero__scrim {
      background: linear-gradient(
        180deg,
        var(--bg) 0%,
        var(--bg) 60%,
        color-mix(in srgb, var(--bg) 55%, transparent) 100%
      );
    }
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
    }
    .hero__cta .btn {
      width: 100%;
    }
  }
  .hero__ticker {
    position: relative;
    z-index: 2;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ------------------------------------------------------------ unlocks */
  .unlocks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(1.5rem, 4vw, 2.6rem);
  }
  .unlock__arrow {
    color: var(--mint);
    font-family: var(--mono);
    font-size: 1.2rem;
  }
  .unlock__k {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    margin: 0.4rem 0 0.5rem;
  }
  .unlock__d {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    max-width: 34ch;
  }

  /* ---- disposable interfaces ---- */
  .disp {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(1.8rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 820px) {
    .disp {
      grid-template-columns: 1fr;
    }
  }
  .disp__h {
    max-width: 16ch;
  }
  .disp__lead {
    max-width: 52ch;
    color: var(--cream-dim);
  }
  .disp__kicker {
    margin: 1.1rem 0 0;
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    font-weight: 700;
    color: var(--mint);
    max-width: 24ch;
  }
  .disp__fig {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-panel);
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }
  .disp__screens {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }
  .disp__screen {
    height: 62px;
    border: 1px dashed var(--muted-2);
    border-radius: 3px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0.3rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    background: rgba(242, 236, 218, 0.018);
  }
  .disp__gen {
    text-align: center;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin: 0.7rem 0;
  }
  .disp__gen::before {
    content: '↑';
    color: var(--mint);
    margin-right: 0.4em;
  }
  .disp__substrate {
    border: 1px solid var(--mint-dim);
    border-radius: 3px;
    background: rgba(143, 230, 164, 0.06);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    align-items: center;
    text-align: center;
  }
  .disp__subname {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--mint);
  }
  .disp__subtag {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.03em;
  }

  /* ------------------------------------------------------------ problem */
  .prob__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.8rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 820px) {
    .prob__grid {
      grid-template-columns: 1fr;
    }
  }
  .prob__text h2 {
    max-width: 16ch;
  }
  .prob__text p {
    max-width: 48ch;
  }
  .prob__cause {
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .coral {
    color: var(--coral);
  }

  .silos {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.3rem 1.1rem 1.1rem;
    background: var(--bg-panel);
  }
  .silos__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
  }
  /* phones: four silos at ~70px each is cramped — drop to a 2x2 so each
     source stays legible */
  @media (max-width: 560px) {
    .silos__row {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
    .silo__label {
      min-height: 0;
    }
  }
  .silo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .silo__label {
    font-size: 0.78rem;
    color: var(--muted);
    text-align: center;
    min-height: 2.4em;
  }
  .silo__db {
    width: 100%;
    text-align: center;
    font-size: 0.78rem;
    color: var(--cream-dim);
    border: 1px solid var(--line-bright);
    border-radius: 3px;
    padding: 0.5em 0.2em;
    background: var(--bg);
  }
  .silo__wire {
    width: 0;
    height: 24px;
    border-left: 1px dashed var(--amber);
    opacity: 0.6;
  }
  .silos__floor {
    margin-top: 0.2rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--cream-dim);
    border: 1px solid var(--line-bright);
    border-radius: 3px;
    padding: 0.7em;
  }
  .silos__note {
    margin-top: 0.8rem;
    font-size: 0.78rem;
    color: var(--amber);
    text-align: center;
  }

  /* --------------------------------------------------------------- idea */
  .idea__def {
    max-width: 22ch;
    font-size: clamp(1.8rem, 5vw, 3rem);
  }
  .idea__sub {
    max-width: 60ch;
    margin-top: 1.2rem;
  }

  /* ------------------------------------------------------------ mission */
  /* Amber is the section's own accent — this is the "prior work / research"
     beat, held distinct from the mint that carries the forward/product claims,
     so mint stops meaning "everything." */
  .mission__tag {
    font-size: 0.8rem;
    color: var(--amber);
    margin: 0 0 0.9rem;
  }
  .mission__tag .k {
    color: var(--amber);
  }
  .mission__title {
    max-width: 22ch;
    font-size: clamp(1.7rem, 4.5vw, 2.7rem);
  }
  .mission__lead {
    max-width: 60ch;
    margin-top: 1.1rem;
    color: var(--cream-dim);
  }
  /* 1px gap over a line-colored bg draws clean dividers no matter how many
     columns wrap (4-up desktop → 2-up → 1-up), with no per-cell border math */
  .concerns {
    list-style: none;
    margin: 2rem 0 0;
    padding: 1px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 1px;
    background: var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .concern {
    padding: clamp(1.1rem, 3vw, 1.5rem);
    background: var(--bg-panel);
  }
  .concern__k {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    color: var(--amber);
  }
  .concern__k::before {
    content: '↳ ';
    color: rgba(230, 181, 103, 0.55);
  }
  .mission__foot a {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .concern__d {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cream-dim);
    max-width: 40ch;
  }
  .mission__foot {
    margin-top: 1.6rem;
    max-width: 62ch;
    color: var(--cream-dim);
  }

  /* ------------------------------------------------------------- vision */
  .vision__title {
    max-width: 24ch;
    font-size: clamp(1.7rem, 4.5vw, 2.7rem);
  }
  .vision__lead {
    max-width: 58ch;
    color: var(--cream-dim);
  }
  .vision__lead a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
